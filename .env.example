# Copy this file to .env and fill in your values. .env is git-ignored.

# Required for the Claude-generated summaries on the Compare and Forecast pages.
# Without it the app still runs; those panels show a notice instead of a summary.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Claude model used for summaries (default: claude-opus-5).
# Cheaper options: claude-sonnet-5, claude-haiku-4-5.
# CLAUDE_MODEL=claude-opus-5

# Optional. Reasoning effort for summaries: low | medium | high | xhigh | max (default: medium).
# Ignored automatically on models that do not support it (for example claude-haiku-4-5).
# SUMMARY_EFFORT=medium

# SEC EDGAR requires a descriptive User-Agent with a contact email on every request
# (it returns 403 without one). Replace with your own project name and email.
SEC_USER_AGENT=AI-Boom-Scorecard/1.0 (your name; your.email@example.com)
